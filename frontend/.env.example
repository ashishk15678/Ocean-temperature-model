# Copy this file to .env and adjust values for your environment.

# Set to true to skip the real backend and use generated mock data.
VITE_USE_MOCK_DATA=false

# Backend base URL.  Leave empty to use the Vite dev-server proxy (/api → localhost:8000).
# In production set this to e.g. https://api.yoursite.com
VITE_API_BASE_URL=

# Full path to the prediction endpoint (resolved relative to API_BASE_URL).
VITE_API_ENDPOINT=/api/v1/predict

# Health check endpoint.
VITE_HEALTH_ENDPOINT=/health

# Enable verbose console logging.
VITE_DEBUG_MODE=false

# How often to poll alarms (ms).
VITE_ALARM_POLL_INTERVAL_MS=5000

# Default date used for predictions.  Must be within AVAILABLE_YEARS (2000-2005).
VITE_DEFAULT_DATE=2005-06-15
