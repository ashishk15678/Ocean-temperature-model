# OceanEmbed Prediction Backend — environment variable overrides
# Copy to .env and adjust paths if needed.
# All paths below are the defaults; they are relative to BackendProd/.

# Path to the production model checkpoint
MODEL_PATH=models/OceanEmbed_best.pth

# Path to training (input) normalization statistics
TRAIN_STATS_PATH=configs/train_normalization_stats(1).json

# Path to target (output) normalization statistics
TARGET_STATS_PATH=configs/target_normalization_stats(1).json

# Directory containing surface_YYYY.nc files
SURFACE_DATA_DIR=data/surface
